    <mxCell id="51" value="Gate MLP computes (from h_A, h_B, h_C concatenated):&#xa;&#xa;Raw logits: [1.52,  0.89,  1.31]&#xa;After softmax:&#xa;   g_A = 0.38  (trust Stream A — entity mismatch)&#xa;   g_B = 0.28  (down-weight — similarity misleading)&#xa;   g_C = 0.34  (trust Stream C — contradiction found)&#xa;&#xa;Sum = 1.00 ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3ee;strokeColor=#e76f51;fontSize=12;align=left;" vertex="1" parent="1">
